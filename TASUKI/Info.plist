<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Privacy: Location for run tracking (規約・プライバシーポリシーと整合) -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>ランニングの距離・ルート計測、およびチーム・駅伝機能での走行記録共有のために位置情報を使用します。</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>スリープ中やロック画面でも走行距離・時間・ペースを記録するため、バックグラウンドで位置情報を使用します。「常に許可」を選ぶと記録が途切れにくくなります。</string>

    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
    </array>

    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- Privacy: HealthKit usage descriptions (規約・プライバシーポリシーと整合) -->
    <key>NSHealthShareUsageDescription</key>
    <string>走行距離、ワークアウト履歴、ルートデータを読み取り、アプリ内の走行記録表示およびバーチャル駅伝の提出に利用します。</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>ワークアウト連携と走行記録の更新のために、Healthデータへの書き込みアクセスを使用します。</string>

</dict>
</plist>
